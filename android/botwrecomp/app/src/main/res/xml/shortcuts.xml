<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: back to the system's Vulkan driver without opening the app first (a custom driver that
     draws garbage, or never draws, leaves Settings out of reach). BOTWRecompActivity.SYSTEM_DRIVER. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="watch_map"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_watch_map"
        android:shortcutLongLabel="@string/shortcut_watch_map_long">
        <intent
            android:action="com.botwrecomp.action.WATCH_MAP"
            android:targetPackage="com.botwrecomp.android"
            android:targetClass="com.botwrecomp.BOTWRecompActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="system_driver"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_system_driver"
        android:shortcutLongLabel="@string/shortcut_system_driver_long">
        <intent
            android:action="com.botwrecomp.action.SYSTEM_DRIVER"
            android:targetPackage="com.botwrecomp.android"
            android:targetClass="com.botwrecomp.BOTWRecompActivity" />
    </shortcut>
</shortcuts>
